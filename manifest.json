{
    "name": "youtube.jp",
    "version": "0.1.0",
    "manifest_version": 3,
    "description": "display only Japanese media on YouTube.",
    "permissions": ["storage", "tabs"],
    "host_permissions": ["https://*.youtube.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://*.youtube.com/*"],
            "js": ["contentScript.js"]
        }
    ],
    "action": {
        "default_icon": {
            "16" : "icon16.png",
            "48" : "icon48.png",
            "128" : "icon128.png"
        },
        "default_title": "Youtube JP Extension",
        "default_popup": "popup.html"
    }
}